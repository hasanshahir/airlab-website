# Copy this file to server/.env and fill in the values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
#  • Atlas (dev):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airlab?retryWrites=true&w=majority
#  • Local / NED:   mongodb://127.0.0.1:27017/airlab
MONGO_URI=

# Origins allowed to call the API with credentials (comma-separated).
# Not needed in dev when using the Vite proxy, but keep the Vite URL here anyway.
CORS_ORIGINS=http://localhost:5173
